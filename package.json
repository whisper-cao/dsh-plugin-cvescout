{
  "name": "dsh-plugin-cvescout",
  "version": "0.1.1",
  "description": "DeepSeek Harness plugin for CVE impact retesting: fingerprint a target, judge it against a CVE's affected range, gather passive evidence, and report a verdict with confidence and limitations.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node test/smoke.mjs && node test/register.mjs",
    "test:e2e": "node test/e2e-local.mjs",
    "check:dist": "npm run build && git diff --exit-code -- lib",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cve",
    "security",
    "vulnerability",
    "fingerprint"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whisper-cao/dsh-plugin-cvescout.git"
  },
  "homepage": "https://github.com/whisper-cao/dsh-plugin-cvescout#readme",
  "bugs": {
    "url": "https://github.com/whisper-cao/dsh-plugin-cvescout/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
